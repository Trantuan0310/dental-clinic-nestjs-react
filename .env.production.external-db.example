DOMAIN=clinic.example.com
TLS_CERT_DIR=/etc/letsencrypt/live/clinic.example.com
DATABASE_URL=postgresql://clinic_app:REPLACE@db.example.com:5432/dental_clinic?sslmode=require
MIGRATION_DATABASE_URL=postgresql://clinic_migration:REPLACE@db.example.com:5432/dental_clinic?sslmode=require
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE
SMTP_PASS=REPLACE
EMAIL_FROM=noreply@clinic.example.com
REDIS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Landing page (gensmile.online/). Baked into the web image at build time:
# change them, then rebuild web (scripts/deploy-vps.sh does). Empty = hidden.
CLINIC_NAME="Nha khoa GENSMILE"
CLINIC_TAGLINE="Nha khoa thẩm mỹ"
CLINIC_PHONE=
CLINIC_ZALO=
CLINIC_EMAIL=
CLINIC_ADDRESS=
CLINIC_MAP_URL=
CLINIC_FACEBOOK_URL=
CLINIC_HOURS="08:00 – 12:00 · 13:30 – 19:00"
CLINIC_SUNDAY_HOURS="Nghỉ"
