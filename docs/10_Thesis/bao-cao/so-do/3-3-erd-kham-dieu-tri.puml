@startuml
!include _kieu.iuml
hide circle
skinparam linetype ortho
left to right direction
skinparam defaultFontSize 13
title Nhóm phiên khám, ghi chú lâm sàng và đơn thuốc

entity "encounters" as Encounter {
  * id : uuid <<PK>>
  --
  * appointment_id : uuid <<FK>>
  * patient_id : uuid <<FK>>
  * dentist_id : uuid <<FK>>
  * status : enum
  * started_at : timestamptz
  closed_at : timestamptz
  summary : varchar
  chief_complaint : varchar
}
entity "clinical_notes" as ClinicalNote {
  * id : uuid <<PK>>
  --
  * encounter_id : uuid <<FK>>
  chief_complaint : varchar
  diagnosis : varchar
  treatment_plan : varchar
  notes : varchar
  * created_at : timestamptz
}
entity "clinical_note_addendums" as ClinicalNoteAddendum {
  * id : uuid <<PK>>
  --
  * clinical_note_id : uuid <<FK>>
  * content : varchar
  * added_by : uuid <<FK>>
  * added_at : timestamptz
}
entity "prescriptions" as Prescription {
  * id : uuid <<PK>>
  --
  * encounter_id : uuid <<FK>>
  diagnosis : varchar
  instructions : varchar
  follow_up_note : varchar
  notes : varchar
  * created_at : timestamptz
}
entity "prescription_lines" as PrescriptionLine {
  * id : uuid <<PK>>
  --
  * prescription_id : uuid <<FK>>
  * sequence : int
  * drug_name : varchar
  * dosage : varchar
  * frequency : varchar
  * duration : varchar
}
entity "dental_chart_snapshots" as DentalChartSnapshot {
  * id : uuid <<PK>>
  --
  * encounter_id : uuid <<FK>>
  * patient_type : enum
  * teeth : jsonb
  * snapshot_at : timestamptz
  snapshot_by : uuid <<FK>>
}

Encounter ||--o| ClinicalNote
ClinicalNote ||--o{ ClinicalNoteAddendum
Encounter ||--o| Prescription
Prescription ||--o{ PrescriptionLine
Encounter ||--o| DentalChartSnapshot
@enduml
