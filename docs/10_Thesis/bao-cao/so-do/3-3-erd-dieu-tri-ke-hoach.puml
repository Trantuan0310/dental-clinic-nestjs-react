@startuml
!include _kieu.iuml
hide circle
skinparam linetype ortho
skinparam defaultFontSize 13
title Nhóm điều trị và kế hoạch điều trị

entity "patients" as Patient {
  * id : uuid <<PK>>
  --
  * code : varchar
  * full_name : varchar
  * dob : timestamptz
  * gender : enum
  primary_phone : varchar
}
entity "encounters" as Encounter {
  * id : uuid <<PK>>
  --
  * appointment_id : uuid <<FK>>
  * patient_id : uuid <<FK>>
  * dentist_id : uuid <<FK>>
  * status : enum
  * started_at : timestamptz
  closed_at : timestamptz
  summary : varchar
  chief_complaint : varchar
}
entity "treatments" as Treatment {
  * id : uuid <<PK>>
  --
  * encounter_id : uuid <<FK>>
  tooth_numbers : jsonb
  * procedure : varchar
  description : varchar
  * unit_price : decimal
  * quantity : int
  service_id : uuid <<FK>>
  plan_item_id : uuid <<FK>>
}
entity "treatment_inventory_usages" as TreatmentInventoryUsage {
  * id : uuid <<PK>>
  --
  * treatment_id : uuid <<FK>>
  * inventory_item_id : uuid <<FK>>
  * quantity : decimal
  * unit : varchar
}
entity "inventory_items" as InventoryItem {
  * id : uuid <<PK>>
  --
  * sku : varchar
  category_id : uuid <<FK>>
  * name : varchar
  description : varchar
  * quantity_on_hand : decimal
  * min_stock_level : decimal
}
entity "treatment_plans" as TreatmentPlan {
  * id : uuid <<PK>>
  --
  * patient_id : uuid <<FK>>
  * dentist_id : uuid <<FK>>
  * title : varchar
  notes : varchar
  * status : enum
  source_encounter_id : uuid <<FK>>
  proposed_at : timestamptz
  accepted_at : timestamptz
  accepted_by : uuid <<FK>>
}
entity "treatment_plan_items" as TreatmentPlanItem {
  * id : uuid <<PK>>
  --
  * plan_id : uuid <<FK>>
  * sequence : int
  service_id : uuid <<FK>>
  * procedure : varchar
  tooth_numbers : jsonb
  * quantity : int
  * unit_price : decimal
}

Patient ||--o{ Encounter
Encounter ||--o{ Treatment
TreatmentPlanItem |o--o{ Treatment
Treatment ||--o{ TreatmentInventoryUsage
InventoryItem ||--o{ TreatmentInventoryUsage
Patient ||--o{ TreatmentPlan
Encounter |o--o{ TreatmentPlan
TreatmentPlan ||--o{ TreatmentPlanItem
@enduml
