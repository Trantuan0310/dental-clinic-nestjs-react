  totalHours          Decimal  @default(0) @map("total_hours") @db.Decimal(8, 2)
  overtimeHours       Decimal  @default(0) @map("overtime_hours") @db.Decimal(8, 2)
  baseSalaryVnd       Decimal  @default(0) @map("base_salary_vnd") @db.Decimal(15, 0)
  commissionVnd       Decimal  @default(0) @map("commission_vnd") @db.Decimal(15, 0)
  overtimePayVnd      Decimal  @default(0) @map("overtime_pay_vnd") @db.Decimal(15, 0)
  bonusVnd            Decimal  @default(0) @map("bonus_vnd") @db.Decimal(15, 0)
  penaltyVnd          Decimal  @default(0) @map("penalty_vnd") @db.Decimal(15, 0)
  grossPayVnd         Decimal  @default(0) @map("gross_pay_vnd") @db.Decimal(15, 0)
  taxTncnVnd          Decimal  @default(0) @map("tax_tncn_vnd") @db.Decimal(15, 0)
  bhxhVnd             Decimal  @default(0) @map("bhxh_vnd") @db.Decimal(15, 0)
  netPayVnd           Decimal  @default(0) @map("net_pay_vnd") @db.Decimal(15, 0)
  computationLog      Json     @map("computation_log") @db.JsonB
  manuallyAdjusted    Boolean  @default(false) @map("manually_adjusted")
  adjustmentNote      String?  @map("adjustment_note")
  computedAt          DateTime @default(now()) @map("computed_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  period        PayrollPeriod              @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  dentist       User                       @relation(fields: [dentistId], references: [id])
  adjustments   PayrollAdjustment[]
  encounterDetails PayrollEncounterDetail[]

  @@unique([payrollPeriodId, dentistId])
  @@index([dentistId, computedAt(sort: Desc)])
  @@map("payroll_line_items")
}

model PayrollEncounterDetail {
  id                    String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  payrollLineItemId     String   @map("payroll_line_item_id") @db.Uuid
  payrollPeriodId       String   @map("payroll_period_id") @db.Uuid
  encounterId           String   @map("encounter_id") @db.Uuid
  treatmentId           String   @map("treatment_id") @db.Uuid
  treatmentRevenueVnd   Decimal  @map("treatment_revenue_vnd") @db.Decimal(15, 0)
  encounterStartAt      DateTime @map("encounter_start_at") @db.Timestamptz()
  encounterEndAt        DateTime @map("encounter_end_at") @db.Timestamptz()
  durationMinutes       Int      @map("duration_minutes")
  treatmentBreakdown    Json     @map("treatment_breakdown") @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()

  lineItem    PayrollLineItem @relation(fields: [payrollLineItemId], references: [id], onDelete: Cascade)
  period      PayrollPeriod   @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  encounter   Encounter       @relation(fields: [encounterId], references: [id])
  treatment   Treatment       @relation(fields: [treatmentId], references: [id])

  @@unique([payrollLineItemId, encounterId, treatmentId])
  @@index([encounterId])
  @@index([payrollPeriodId, encounterId])
  @@map("payroll_encounter_details")
}

model PayrollAdjustment {
  id                   String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  payrollLineItemId    String                @map("payroll_line_item_id") @db.Uuid
  type                 PayrollAdjustmentType
  amountVnd            Decimal               @map("amount_vnd") @db.Decimal(15, 0)
  reason               String
  adjustedByUserId     String                @map("adjusted_by_user_id") @db.Uuid
  adjustedAt           DateTime              @default(now()) @map("adjusted_at") @db.Timestamptz()

  lineItem     PayrollLineItem @relation(fields: [payrollLineItemId], references: [id], onDelete: Cascade)
  adjustedByUser User          @relation("PayrollAdjustmentActor", fields: [adjustedByUserId], references: [id])

  @@index([payrollLineItemId, adjustedAt(sort: Desc)])
  @@map("payroll_adjustments")
}

// =============================================================================
// EXPENSE MODULE (BR-EXP-001 — wired from billing.service.ts financeSummary)
// =============================================================================

enum ExpenseStatus {
  DRAFT
  APPROVED
  REJECTED
  REIMBURSED
}

enum ExpenseType {
  OPERATING
  INVESTMENT
  OTHER
}

model ExpenseCategory {
  id          String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String       @db.VarChar(100)
  description String?
  type        ExpenseType  @default(OPERATING)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  expenses Expense[]

  @@unique([name])
  @@map("expense_categories")
}

model Expense {
  id           String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code         String         @unique @db.VarChar(20)
  amount      Decimal        @db.Decimal(15, 0)
  description  String
  expenseDate  DateTime      @map("expense_date") @db.Date
  status       ExpenseStatus  @default(DRAFT)
  categoryId   String?       @map("category_id") @db.Uuid
  notes        String?
  receiptUrl   String?       @map("receipt_url")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy    String?       @map("created_by") @db.Uuid
  updatedBy    String?       @map("updated_by") @db.Uuid
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz()
  version      Int           @default(1)

  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])
  creator    User?           @relation("ExpenseCreator", fields: [createdBy], references: [id])
  updater    User?           @relation("ExpenseUpdater", fields: [updatedBy], references: [id])
  audits     ExpenseAudit[]

  @@index([status, expenseDate(sort: Desc)])
  @@index([categoryId])
  @@index([createdBy])
  @@map("expenses")
}

model ExpenseAudit {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  expenseId  String   @map("expense_id") @db.Uuid
  action     String
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, createdAt(sort: Desc)])
  @@map("expense_audits")
}
