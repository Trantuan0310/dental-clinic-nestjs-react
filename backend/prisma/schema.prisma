// =============================================================================
// Prisma Schema — Dental Clinic Management System
// =============================================================================
//
// File này là SOURCE OF TRUTH cho runtime database.
// Các file SQL chi tiết (CREATE TABLE, indexes, constraints, seed):
//   docs/04_Database/schema-per-module/<module>.md
//
// Phase 5 — Database Design (2026-07-13)
// Spec: docs/03_Specification/<Module>/SPEC.md
// ADR liên quan:
//   - ADR-0005: UUID v7 làm PK
//   - ADR-0006: Soft Delete mặc định
//   - ADR-0007: Cross-Module Event Bus
//   - ADR-0008: Transactional Encounter Close
//
// Lưu ý:
// - Prisma xài native Postgres enum cho status
// - Composite PK cho bảng join
// - Extensions: pg_trgm, btree_gist, uuid-ossp (Postgres generate UUID v7)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTH MODULE (8 bảng)
// =============================================================================

enum UserStatus {
  ACTIVE
  PENDING_SETUP
  DEACTIVATED
}

enum ActionAudit {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REFRESH_REUSE_DETECTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_DONE
  PASSWORD_CHANGED
  USER_CREATED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_PASSWORD_RESET_BY_ADMIN
  ROLE_CREATED
  ROLE_PERMISSIONS_CHANGED
  LOGOUT_ALL
}

model User {
  id                     String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email                  String         @db.VarChar(255)
  passwordHash           String         @map("password_hash")
  fullName               String         @map("full_name") @db.VarChar(200)
  status                 UserStatus     @default(ACTIVE)
  failedLoginAttempts    Int            @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?      @map("locked_until") @db.Timestamptz()
  lastLoginAt            DateTime?      @map("last_login_at") @db.Timestamptz()
  deactivatedAt          DateTime?      @map("deactivated_at") @db.Timestamptz()
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy              String?        @map("created_by") @db.Uuid
  updatedBy              String?        @map("updated_by") @db.Uuid
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz()

  // Self-references
  creator                User?          @relation("UserCreator", fields: [createdBy], references: [id])
  updater                User?          @relation("UserUpdater", fields: [updatedBy], references: [id])
  created                User[]         @relation("UserCreator")
  updated                User[]         @relation("UserUpdater")

  // Relations
  userRoles              UserRole[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]

  // Patient-owned relations (created_by, updated_by FK to user)
  createdPatients        Patient[]      @relation("PatientCreator")
  updatedPatients        Patient[]      @relation("PatientUpdater")
  createdPatientIdentifiers PatientIdentifier[] @relation("PatientIdentifierCreator")

  // Appointments
  appointmentsAsDentist  Appointment[]  @relation("AppointmentDentist")
  createdAppointments    Appointment[]  @relation("AppointmentCreator")
  updatedAppointments    Appointment[]  @relation("AppointmentUpdater")
  confirmedAppointments  Appointment[]  @relation("AppointmentConfirmedBy")
  checkedInAppointments  Appointment[]  @relation("AppointmentCheckedInBy")
  cancelledAppointments  Appointment[]  @relation("AppointmentCancelledBy")
  workingSchedules       WorkingSchedule[]
  timeOffs               TimeOff[]
  // Note: createdShiftRegistrationsAsAdmin was removed — admin-on-behalf-of
  // creation uses the same createdByUserId column with the existing
  // ShiftRegistrationCreator relation. The audit log records the actor.

  // Encounters
  encountersAsDentist    Encounter[]
  lastClinicalNoteEdit   ClinicalNote[] @relation("ClinicalNoteLastEditor")
  createdClinicalNoteAddendums ClinicalNoteAddendum[]   @relation("AddendumAddedBy")
  // Without this, prisma validation fails.
  createdEncounterAudits EncounterAudit[]
  createdTreatments      Treatment[]    @relation("TreatmentCreator")
  createdPrescriptions   Prescription[] @relation("PrescriptionCreator")
  snapshottedCharts      DentalChartSnapshot[]

  // Billing
  issuedInvoices         Invoice[]      @relation("InvoiceIssuer")
  createdInvoices        Invoice[]      @relation("InvoiceCreator")
  voidedInvoices         Invoice[]      @relation("InvoiceVoidedBy")
  receivedPayments       Payment[]
  invoiceAuditActors     InvoiceAudit[]

  // Inventory
  createdCategories      InventoryCategory[]   @relation("InventoryCategoryCreator")
  updatedCategories      InventoryCategory[]   @relation("InventoryCategoryUpdater")
  createdItems           InventoryItem[]
  performedMovements     StockMovement[]

  // Expense (BR-EXP-001)
  createdExpenses     Expense[]    @relation("ExpenseCreator")
  updatedExpenses     Expense[]    @relation("ExpenseUpdater")

  // Payroll (Phase 9)
  compensations              DentistCompensation[]   @relation("CompensationDentist")
  approvedCompensations      DentistCompensation[]  @relation("CompensationApprover")
  shiftRegistrations         ShiftRegistration[]    @relation("ShiftRegistrationDentist")
  approvedShiftRegistrations ShiftRegistration[]    @relation("ShiftRegistrationApprover")
  createdShiftRegistrations  ShiftRegistration[]    @relation("ShiftRegistrationCreator")
  payrollLineItems           PayrollLineItem[]
  createdPayrollPeriods      PayrollPeriod[]        @relation("PayrollPeriodCreator")
  lockedPayrollPeriods       PayrollPeriod[]        @relation("PayrollPeriodLocker")
  approvedPayrollPeriods     PayrollPeriod[]        @relation("PayrollPeriodApprover")
  paidPayrollPeriods         PayrollPeriod[]        @relation("PayrollPeriodPayer")
  createdPayrollAdjustments  PayrollAdjustment[]    @relation("PayrollAdjustmentActor")
  payrollConfigUpdated       PayrollConfig? @relation("PayrollConfigUpdater")

  // NOT a plain @@unique: Prisma's schema DSL can't express a partial index,
  // and email must stay reusable once a user is deactivated/deleted. The
  // real constraint is a partial unique index — active rows only — created
  // in migration 013_soft_delete_partial_unique (users_email_active_key).
  @@index([email])
  @@index([status])
  @@index([deactivatedAt])
  @@index([fullName])
  @@index([status, fullName])
  @@map("users")
}

model Role {
  id              String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code            String         @db.VarChar(50)
  name            String         @db.VarChar(100)
  description     String?
  isSystem        Boolean        @default(false) @map("is_system")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy       String?        @map("created_by") @db.Uuid
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz()

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code        String           @db.VarChar(100)
  resource    String           @db.VarChar(50)
  action      String           @db.VarChar(50)
  description String?
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@unique([code])
  @@index([resource])
  @@map("permissions")
}

model UserRole {
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz()
  assignedBy  String?   @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz()
  replacedByToken   String?   @map("replaced_by_token") @db.Uuid
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  actorEmailAtTime String? @map("actor_email_at_time") @db.VarChar(255)
  action          String   @db.VarChar(100)
  targetType      String?  @map("target_type") @db.VarChar(50)
  targetId        String?  @map("target_id") @db.Uuid
  metadata        Json?    @db.JsonB
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent")
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz()

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

// =============================================================================
// PATIENTS MODULE (4 bảng)
// =============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum IdentifierType {
  CCCD
  CMND
  PASSPORT
}

model Patient {
  id                  String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code                String   @db.VarChar(20)
  fullName            String   @map("full_name") @db.VarChar(200)
  dob                 DateTime @db.Date
  gender              Gender
  primaryPhone        String?  @map("primary_phone") @db.VarChar(20)
  email               String?  @db.VarChar(255)
  address             String?
  occupation          String?  @db.VarChar(100)
  allergies           Json     @default("[]") @db.JsonB
  chronicDiseases     Json     @default("[]") @map("chronic_diseases") @db.JsonB
  currentMedications  Json     @default("[]") @map("current_medications") @db.JsonB
  contactPersonName   String?  @map("contact_person_name") @db.VarChar(200)
  contactPersonPhone  String?  @map("contact_person_phone") @db.VarChar(20)
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy           String?  @map("deleted_by") @db.Uuid

  creator User? @relation("PatientCreator", fields: [createdBy], references: [id])
  updater User? @relation("PatientUpdater", fields: [updatedBy], references: [id])

  phoneHistory  PatientPhoneHistory[]
  identifiers   PatientIdentifier[]
  mergeLogs     PatientMergeLog[] @relation("MergeTarget")
  mergedFrom    PatientMergeLog[] @relation("MergeSource")

  appointments  Appointment[]
  encounters    Encounter[]
  invoices      Invoice[]

  @@unique([code])
  @@index([primaryPhone])
  @@index([fullName])
  @@index([createdAt(sort: Desc)])
  // Note: GIN indexes on allergies/chronic_diseases/current_medications are
  // created via raw SQL in migration 010_perf_indexes (CONCURRENTLY).
  @@map("patients")
}

model PatientPhoneHistory {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  oldPhone   String?  @map("old_phone") @db.VarChar(20)
  newPhone   String   @map("new_phone") @db.VarChar(20)
  changedBy  String?  @map("changed_by") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, changedAt(sort: Desc)])
  @@map("patient_phone_history")
}

model PatientIdentifier {
  id         String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  patientId  String         @map("patient_id") @db.Uuid
  type       IdentifierType
  value      String         @db.VarChar(50)
  issuedAt   DateTime?      @map("issued_at") @db.Date
  issuedBy   String?        @map("issued_by") @db.VarChar(200)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  createdBy  String?        @map("created_by") @db.Uuid
  deletedAt  DateTime?      @map("deleted_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id])
  creator User?  @relation("PatientIdentifierCreator", fields: [createdBy], references: [id])

  // NOT a plain @@unique — see migration 013_soft_delete_partial_unique
  // (patient_identifiers_type_value_active_key), a partial unique index that
  // excludes soft-deleted rows so a previously-removed identifier value can
  // be re-added without hitting a raw DB constraint error.
  @@index([type, value])
  @@index([patientId])
  @@map("patient_identifiers")
}

model PatientMergeLog {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sourcePatientId  String   @map("source_patient_id") @db.Uuid
  targetPatientId  String   @map("target_patient_id") @db.Uuid
  fieldMapping     Json     @map("field_mapping") @db.JsonB
  migratedFkCount  Json     @map("migrated_fk_count") @db.JsonB
  mergedBy         String   @map("merged_by") @db.Uuid
  mergedAt         DateTime @default(now()) @map("merged_at") @db.Timestamptz()

  source Patient @relation("MergeSource", fields: [sourcePatientId], references: [id])
  target Patient @relation("MergeTarget", fields: [targetPatientId], references: [id])

  @@index([targetPatientId, mergedAt(sort: Desc)])
  @@map("patient_merge_logs")
}

// =============================================================================
// APPOINTMENTS MODULE (4 bảng)
// =============================================================================

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  WALK_IN
  PHONE
  ONLINE
  RETURNING
}

enum TimeOffType {
  VACATION
  SICK
  TRAINING
  OTHER
}

model Appointment {
  id                String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  patientId         String              @map("patient_id") @db.Uuid
  dentistId         String              @map("dentist_id") @db.Uuid
  startAt           DateTime            @map("start_at") @db.Timestamptz()
  endAt             DateTime            @map("end_at") @db.Timestamptz()
  status            AppointmentStatus   @default(SCHEDULED)
  reason            String?
  notes             String?
  source            AppointmentSource   @default(PHONE)
  confirmedAt       DateTime?           @map("confirmed_at") @db.Timestamptz()
  confirmedBy       String?             @map("confirmed_by") @db.Uuid
  checkedInAt       DateTime?           @map("checked_in_at") @db.Timestamptz()
  checkedInBy       String?             @map("checked_in_by") @db.Uuid
  cancelledAt       DateTime?           @map("cancelled_at") @db.Timestamptz()
  cancelledBy       String?             @map("cancelled_by") @db.Uuid
  cancelledReason   String?             @map("cancelled_reason")
  noShowAt          DateTime?           @map("no_show_at") @db.Timestamptz()
  rescheduleCount   Int                 @default(0) @map("reschedule_count")
  lastRescheduleAt  DateTime?           @map("last_reschedule_at") @db.Timestamptz()
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy         String?             @map("created_by") @db.Uuid
  updatedBy         String?             @map("updated_by") @db.Uuid
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz()

  patient     Patient @relation(fields: [patientId], references: [id])
  dentist     User    @relation("AppointmentDentist", fields: [dentistId], references: [id])
  creator     User?   @relation("AppointmentCreator", fields: [createdBy], references: [id])
  updater     User?   @relation("AppointmentUpdater", fields: [updatedBy], references: [id])
  confirmedByUser User? @relation("AppointmentConfirmedBy", fields: [confirmedBy], references: [id])
  checkedInByUser User? @relation("AppointmentCheckedInBy", fields: [checkedInBy], references: [id])
  cancelledByUser User? @relation("AppointmentCancelledBy", fields: [cancelledBy], references: [id])

  encounter        Encounter?
  rescheduleLogs   AppointmentRescheduleLog[]

  @@unique([dentistId, startAt], name: "unique_active_slot")
  @@index([dentistId, startAt])
  @@index([patientId, startAt(sort: Desc)])
  @@index([startAt])
  @@index([status, startAt])
  // Note: composite (status, startAt, dentistId) created in migration 010.
  @@map("appointments")
}

model WorkingSchedule {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  dentistId        String   @map("dentist_id") @db.Uuid
  dayOfWeek        Int      @map("day_of_week")
  startTime        DateTime @map("start_time") @db.Time(0)
  endTime          DateTime @map("end_time") @db.Time(0)
  slotDurationMin  Int      @default(30) @map("slot_duration_min")
  validFrom        DateTime @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  isPaidShift      Boolean  @default(true) @map("is_paid_shift")
  shiftType        ShiftType @default(FULL_DAY) @map("shift_type")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy        String?  @map("created_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()

  dentist User @relation(fields: [dentistId], references: [id])

  @@index([dentistId, dayOfWeek, validFrom(sort: Desc)])
  @@map("working_schedules")
}

model TimeOff {
  id          String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  dentistId   String      @map("dentist_id") @db.Uuid
  startAt     DateTime    @map("start_at") @db.Timestamptz()
  endAt       DateTime    @map("end_at") @db.Timestamptz()
  type        TimeOffType
  reason      String?
  createdBy   String      @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz()

  dentist User @relation(fields: [dentistId], references: [id])

  @@index([dentistId, startAt, endAt])
  @@map("time_offs")
}

model AppointmentRescheduleLog {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  appointmentId   String   @map("appointment_id") @db.Uuid
  oldDentistId    String?  @map("old_dentist_id") @db.Uuid
  oldStartAt      DateTime @map("old_start_at") @db.Timestamptz()
  oldEndAt        DateTime @map("old_end_at") @db.Timestamptz()
  newDentistId    String?  @map("new_dentist_id") @db.Uuid
  newStartAt      DateTime @map("new_start_at") @db.Timestamptz()
  newEndAt        DateTime @map("new_end_at") @db.Timestamptz()
  reason          String?
  changedBy       String   @map("changed_by") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz()

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId, changedAt(sort: Desc)])
  @@map("appointment_reschedule_logs")
}

// =============================================================================
// MEDICAL RECORDS MODULE (9 bảng)
// =============================================================================

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PatientType {
  ADULT
  CHILD
}

model Encounter {
  id                 String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  appointmentId      String          @unique @map("appointment_id") @db.Uuid
  patientId          String          @map("patient_id") @db.Uuid
  dentistId          String          @map("dentist_id") @db.Uuid
  status             EncounterStatus @default(IN_PROGRESS)
  startedAt          DateTime        @default(now()) @map("started_at") @db.Timestamptz()
  closedAt           DateTime?       @map("closed_at") @db.Timestamptz()
  summary            String?
  chiefComplaint     String?         @map("chief_complaint")
  diagnosis          String?
  treatmentPlanText  String?         @map("treatment_plan_text")
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz()
  cancelledBy        String?         @map("cancelled_by") @db.Uuid
  cancelledReason    String?         @map("cancelled_reason")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  appointment       Appointment            @relation(fields: [appointmentId], references: [id])
  patient           Patient                @relation(fields: [patientId], references: [id])
  dentist           User                   @relation(fields: [dentistId], references: [id])
  clinicalNote      ClinicalNote?
  treatments        Treatment[]
  prescription      Prescription?
  dentalChart       DentalChartSnapshot?
  audits            EncounterAudit[]
  invoice           Invoice?
  payrollDetails    PayrollEncounterDetail[]

  @@index([patientId, startedAt(sort: Desc)])
  @@index([dentistId, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@map("encounters")
}

model ClinicalNote {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  encounterId    String    @unique @map("encounter_id") @db.Uuid
  chiefComplaint String?   @map("chief_complaint")
  diagnosis      String?
  treatmentPlan  String?   @map("treatment_plan")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  lastEditedBy   String?   @map("last_edited_by") @db.Uuid
  isLocked       Boolean   @default(false) @map("is_locked")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz()

  encounter  Encounter              @relation(fields: [encounterId], references: [id])
  lastEditor User?                  @relation("ClinicalNoteLastEditor", fields: [lastEditedBy], references: [id])
  addendums  ClinicalNoteAddendum[]

  @@map("clinical_notes")
}

model ClinicalNoteAddendum {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  clinicalNoteId String  @map("clinical_note_id") @db.Uuid
  content       String
  addedBy       String   @map("added_by") @db.Uuid
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz()

  clinicalNote ClinicalNote @relation(fields: [clinicalNoteId], references: [id])
