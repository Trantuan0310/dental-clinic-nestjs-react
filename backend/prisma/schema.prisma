model PayrollConfig {
  id                     String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  payrollCycle           PayrollCycle @default(MONTHLY) @map("payroll_cycle")
  overtimeMultiplier     Decimal  @default(1.50) @map("overtime_multiplier") @db.Decimal(4, 2)
  defaultTaxTncnPct      Decimal  @default(0.10) @map("default_tax_tncn_pct") @db.Decimal(5, 4)
  bhxhPct                Decimal  @default(0.08) @map("bhxh_pct") @db.Decimal(5, 4)
  bhytPct                Decimal  @default(0.015) @map("bhyt_pct") @db.Decimal(5, 4)
  bhtnPct                Decimal  @default(0.01) @map("bhtn_pct") @db.Decimal(5, 4)
  minGrossForBhxh        Decimal  @default(4680000) @map("min_gross_for_bhxh") @db.Decimal(15, 0)
  probationSalaryPct     Decimal  @default(0.85) @map("probation_salary_pct") @db.Decimal(4, 2)
  taxBrackets            Json     @map("tax_brackets") @db.JsonB
  updatedByUserId        String?  @unique          @map("updated_by_user_id") @db.Uuid
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  user User? @relation("PayrollConfigUpdater", fields: [updatedByUserId], references: [id])

  @@map("payroll_config")
}

model DentistCompensation {
  id                  String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  dentistId           String   @map("dentist_id") @db.Uuid
  effectiveFrom       DateTime @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date
  baseSalaryVnd       Decimal  @map("base_salary_vnd") @db.Decimal(15, 0)
  commissionPct       Decimal  @default(0) @map("commission_pct") @db.Decimal(5, 4)
  overtimeHourlyVnd   Decimal  @default(0) @map("overtime_hourly_vnd") @db.Decimal(15, 0)
  approvedByUserId    String?  @map("approved_by_user_id") @db.Uuid
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz()
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz()

  dentist        User  @relation("CompensationDentist", fields: [dentistId], references: [id])
  approvedByUser User? @relation("CompensationApprover", fields: [approvedByUserId], references: [id])

  @@index([dentistId, effectiveFrom(sort: Desc)])
  @@index([effectiveFrom, effectiveTo])
  @@map("dentist_compensations")
}

model PayrollPeriod {
  id                   String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  periodStart          DateTime            @map("period_start") @db.Date
  periodEnd            DateTime            @map("period_end") @db.Date
  payrollCycle         PayrollCycle        @map("payroll_cycle")
  status               PayrollPeriodStatus @default(DRAFT)
  /// BR-PAY-023: Frozen snapshot of PayrollConfig captured at period creation.
  /// Re-computing this period will always use THIS snapshot, not the live config,
  /// so later config edits do not retroactively change historical payroll.
  configSnapshot       Json                @map("config_snapshot") @db.JsonB
  /// BR-PAY-019: Optional link to a prior period this was opened from.
  openedFromPeriodId   String?             @map("opened_from_period_id") @db.Uuid
  createdByUserId      String?             @map("created_by_user_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  lockedByUserId       String?             @map("locked_by_user_id") @db.Uuid
  lockedAt             DateTime?           @map("locked_at") @db.Timestamptz()
  approvedByUserId     String?             @map("approved_by_user_id") @db.Uuid
  approvedAt           DateTime?           @map("approved_at") @db.Timestamptz()
  markedPaidByUserId   String?             @map("marked_paid_by_user_id") @db.Uuid
  paidAt               DateTime?           @map("paid_at") @db.Timestamptz()
  paymentReference     String?             @map("payment_reference")
  lockedImmutableAt    DateTime?           @map("locked_immutable_at") @db.Timestamptz()

  creator       User?           @relation("PayrollPeriodCreator", fields: [createdByUserId], references: [id])
  locker        User?           @relation("PayrollPeriodLocker", fields: [lockedByUserId], references: [id])
  approver      User?           @relation("PayrollPeriodApprover", fields: [approvedByUserId], references: [id])
  payer         User?           @relation("PayrollPeriodPayer", fields: [markedPaidByUserId], references: [id])
  openedFrom    PayrollPeriod?  @relation("PeriodReopen", fields: [openedFromPeriodId], references: [id])
  reopens       PayrollPeriod[] @relation("PeriodReopen")

  lineItems  PayrollLineItem[]
  encounters PayrollEncounterDetail[]

  // BR-PAY-003 + BR-PAY-019: Partial unique constraint lives in migration SQL,
  // not in Prisma schema. We need:
  //   - UNIQUE(period_start, period_end) for non-LOCKED rows (active period)
  //   - UNIQUE(period_start, period_end) for non-adjustment rows
  // Prisma @@unique cannot express partial indexes, so this is enforced via:
  //   CREATE UNIQUE INDEX idx_payroll_periods_no_overlap
  //     ON payroll_periods (period_start, period_end)
  //     WHERE status != 'LOCKED' AND opened_from_period_id IS NULL;
  // See: docs/04_Database/migrations/009_payroll.sql (R2-3.2 fix)
  @@index([status, periodStart(sort: Desc)])
  @@index([openedFromPeriodId])
  @@map("payroll_periods")
}

model PayrollLineItem {
  id                  String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  payrollPeriodId     String   @map("payroll_period_id") @db.Uuid
  dentistId           String   @map("dentist_id") @db.Uuid
  encountersCount     Int      @default(0) @map("encounters_count")
  totalRevenueVnd     Decimal  @default(0) @map("total_revenue_vnd") @db.Decimal(15, 0)
