  treatment Treatment? @relation(fields: [treatmentId], references: [id])

  @@index([invoiceId, sequence])
  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceId   String        @map("invoice_id") @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  status      PaymentStatus @default(COMPLETED)
  paidAt      DateTime      @default(now()) @map("paid_at") @db.Timestamptz()
  note        String?
  receivedBy  String        @map("received_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  receivedByUser User @relation(fields: [receivedBy], references: [id])

  @@index([invoiceId, paidAt(sort: Desc)])
  @@map("payments")
}

model InvoiceAudit {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  action     String   @db.VarChar(50)
