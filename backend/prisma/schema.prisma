enum ShiftType {
  MORNING
  AFTERNOON
  FULL_DAY
  NIGHT
}

enum PayrollCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayrollPeriodStatus {
  DRAFT
  REVIEWING
  APPROVED
  PAID
  LOCKED
}

enum PayrollAdjustmentType {
  BONUS
  PENALTY
  DEDUCTION
  MANUAL_OVERRIDE
}

enum ShiftRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ShiftRegistration {
  id              String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  dentistId       String                 @map("dentist_id") @db.Uuid
  date            DateTime               @db.Date
  startTime       String                 @map("start_time") @db.VarChar(5)
  endTime         String                 @map("end_time") @db.VarChar(5)
  maxEncounters   Int?                   @map("max_encounters")
  notes           String?
  status          ShiftRegistrationStatus @default(PENDING)
  approvedByUserId String?               @map("approved_by_user_id") @db.Uuid
  approvedAt      DateTime?              @map("approved_at") @db.Timestamptz()
  rejectionReason String?                @map("rejection_reason")
  cancelledAt     DateTime?              @map("cancelled_at") @db.Timestamptz()
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz()
