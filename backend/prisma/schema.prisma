model StockMovement {
  id              String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  inventoryItemId String         @map("inventory_item_id") @db.Uuid
  type            MovementType
  refType         MovementRefType? @map("ref_type")
  refId           String?        @map("ref_id") @db.Uuid
  quantityBefore  Decimal        @map("quantity_before") @db.Decimal(12, 4)
  quantityAfter   Decimal        @map("quantity_after") @db.Decimal(12, 4)
  diff            Decimal        @db.Decimal(12, 4)
  reason          String?
  performedBy     String?        @map("performed_by") @db.Uuid
  performedAt     DateTime       @default(now()) @map("performed_at") @db.Timestamptz()

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  performedByUser User?       @relation(fields: [performedBy], references: [id])

  @@index([inventoryItemId, performedAt(sort: Desc)])
  @@index([type, performedAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

