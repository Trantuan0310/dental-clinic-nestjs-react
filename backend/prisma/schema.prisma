enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOIDED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

model Invoice {
  id                String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code              String         @db.VarChar(20)
  encounterId       String         @unique @map("encounter_id") @db.Uuid
  patientId         String         @map("patient_id") @db.Uuid
  status            InvoiceStatus  @default(DRAFT)
  subtotal          Decimal        @default(0) @db.Decimal(12, 2)
  discountType      DiscountType?  @map("discount_type")
  discountValue     Decimal?       @map("discount_value") @db.Decimal(12, 2)
  total             Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 2)
  outstandingAmount Decimal        @default(0) @map("outstanding_amount") @db.Decimal(12, 2)
  notes             String?
  issuedAt          DateTime?      @map("issued_at") @db.Timestamptz()
  issuedBy          String?        @map("issued_by") @db.Uuid
  voidedAt          DateTime?      @map("voided_at") @db.Timestamptz()
  voidedBy          String?        @map("voided_by") @db.Uuid
  voidReason        String?        @map("void_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy         String?        @map("created_by") @db.Uuid
  version           Int            @default(0)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz()

  encounter Encounter     @relation(fields: [encounterId], references: [id])
  patient   Patient       @relation(fields: [patientId], references: [id])
  issuer    User?         @relation("InvoiceIssuer", fields: [issuedBy], references: [id])
  voider    User?         @relation("InvoiceVoidedBy", fields: [voidedBy], references: [id])
  creator   User?         @relation("InvoiceCreator", fields: [createdBy], references: [id])
  items     InvoiceItem[]
  payments  Payment[]
  audits    InvoiceAudit[]

  @@unique([code])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([status])
  // Note: composite (status, createdAt DESC) created in migration 010.
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceId   String    @map("invoice_id") @db.Uuid
  treatmentId String?   @map("treatment_id") @db.Uuid
  sequence    Int       @default(0)
  description String
  quantity    Decimal   @default(1) @db.Decimal(8, 2)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal   @map("line_total") @db.Decimal(12, 2)
