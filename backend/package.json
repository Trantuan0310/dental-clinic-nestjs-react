{
  "name": "dental-clinic-backend",
  "version": "1.0.0",
  "description": "Dental Clinic Management System - Backend",
  "author": "Dental Clinic Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=/e2e/ --runInBand",
    "test:integration": "jest --testRegex=\".controller.spec.ts$\" --runInBand",
    "test:domain": "jest --testRegex=\"/domain/.*\\\\.spec\\\\.ts$\" --runInBand",
    "test:ci": "jest --runInBand --ci --coverage --maxWorkers=1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:clinical": "ts-node prisma/seed-clinical.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 5 && prisma migrate dev && prisma db seed",
    "db:setup": "npm run db:up && timeout 5 && prisma migrate deploy && npx ts-node prisma/seed.ts",
    "db:baseline": "prisma migrate resolve --applied 001_init && npx ts-node prisma/seed.ts",
    "prisma": {
      "seed": "ts-node prisma/seed.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tar": "^7.5.19",
    "undici": "^6.27.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@prisma/client": "^5.10.0",
    "@types/multer": "^2.2.0",
    "argon2": "^0.31.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "openai": "^4.104.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "nodemailer": "^9.0.3",
    "prettier": "^3.2.5",
    "prisma": "^5.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.ts",
      "**/*.controller.ts",
      "!**/*.module.ts",
      "!**/index.ts",
      "!**/main.ts",
      "!**/*.dto.ts",
      "!**/*.types.ts",
      "!**/domain/**",
      "!**/__mocks__/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 40,
        "branches": 30,
        "functions": 34,
        "lines": 40
      },
      "./src/auth/": {
        "statements": 55,
        "branches": 40,
        "functions": 55,
        "lines": 55
      },
      "./src/users/": {
        "statements": 55,
        "branches": 35,
        "functions": 60,
        "lines": 55
      },
      "./src/patients/": {
        "statements": 40,
        "branches": 30,
        "functions": 30,
        "lines": 40
      },
      "./src/appointments/": {
        "statements": 30,
        "branches": 25,
        "functions": 30,
        "lines": 30
      },
      "./src/medical-records/": {
        "statements": 40,
        "branches": 35,
        "functions": 40,
        "lines": 45
      },
      "./src/billing/": {
        "statements": 25,
        "branches": 10,
        "functions": 15,
        "lines": 25
      },
      "./src/inventory/": {
        "statements": 40,
        "branches": 35,
        "functions": 30,
        "lines": 45
      },
      "./src/payroll/": {
        "statements": 40,
        "branches": 30,
        "functions": 30,
        "lines": 45
      },
      "./src/roles/": {
        "statements": 40,
        "branches": 15,
        "functions": 50,
        "lines": 40
      },
      "./src/audit/": {
        "statements": 90,
        "branches": 90,
        "functions": 95,
        "lines": 90
      },
      "./src/common/": {
        "statements": 95,
        "branches": 95,
        "functions": 100,
        "lines": 95
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
