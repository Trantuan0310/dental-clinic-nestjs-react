# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dental_clinic

# JWT
JWT_SECRET=change-this-to-a-secure-secret-in-production
JWT_ACCESS_TTL=15m

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Email (mock for MVP)
EMAIL_MOCK=true

# AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Redis (cache AI summaries)
REDIS_URL=redis://localhost:6379
