DOMAIN=www.gensmile.online
TLS_CERT_DIR=/opt/dental-clinic/certs

# Local PostgreSQL for the VPS demo. Compose builds internal sslmode=require
# URLs from these values and never publishes port 5432.
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental_app
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_HEX_PASSWORD
POSTGRES_CERT_DIR=/opt/dental-clinic/postgres-certs

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Demo default: no real email provider is needed. Set false + SMTP values for public use.
EMAIL_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gensmile.online
REDIS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash