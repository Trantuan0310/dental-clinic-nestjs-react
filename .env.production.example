DOMAIN=www.gensmile.online
TLS_CERT_DIR=/opt/dental-clinic/certs

# Local PostgreSQL for the VPS demo. Compose builds internal sslmode=require
# URLs from these values and never publishes port 5432.
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental_app
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_HEX_PASSWORD
POSTGRES_CERT_DIR=/opt/dental-clinic/postgres-certs

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Demo default: no real email provider is needed. Set false + SMTP values for public use.
EMAIL_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gensmile.online
# Clinic inbox(es) emailed when a patient books online or answers the
# front desk (comma separated). Empty = no email; the sidebar badge still counts.
BOOKING_NOTIFY_EMAILS=
# Online booking: minimum notice in minutes between sending a request and the
# visit, so the front desk has time to confirm it (default 120). Staff booking
# at the desk is not limited. Unconfirmed requests expire once their time passes.
BOOKING_MIN_LEAD_MIN=120
# Online booking: how many days ahead a patient may ask for (default 60, after
# the clinic's today). The public date picker stops there; later visits are
# booked by phone.
BOOKING_MAX_DAYS_AHEAD=60
# Minutes between suggested start times in every slot list (online booking,
# booking form, rescheduling, search), whatever the visit's length (default
# 15, 5-60). A time off the grid is still accepted if it fits.
SLOT_STEP_MIN=15
REDIS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# AI through a gateway (xkiro, OpenRouter, …); takes precedence over Gemini.
# AI_API_FORMAT: openai (Chat Completions, most gateways) or anthropic (Messages).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_FORMAT=openai

# Landing page (gensmile.online/). Baked into the web image at build time:
# change them, then rebuild web (scripts/deploy-vps.sh does). Empty = hidden.
CLINIC_NAME="Nha khoa GENSMILE"
CLINIC_TAGLINE="Nha khoa thẩm mỹ"
CLINIC_PHONE=
CLINIC_ZALO=
CLINIC_EMAIL=
CLINIC_ADDRESS=
CLINIC_MAP_URL=
CLINIC_FACEBOOK_URL=
CLINIC_HOURS="08:00 – 12:00 · 13:30 – 19:00"
CLINIC_SUNDAY_HOURS="Nghỉ"
